# Staging environment configuration
# This file is used for staging/dev branch deployments

CI=false
GENERATE_SOURCEMAP=false

# Ark Network (signet testnet)
VITE_ARK_SERVER=https://mutinynet.arkade.sh
VITE_BOLTZ_URL=https://api.boltz.signet.arkade.sh
VITE_DELEGATE_ENABLED=false

# Chimera API
VITE_CHIMERA_API=https://api.staging.chimerawallet.com/v1

# TGE countdown (StakingBanner) — ISO date string. Countdown is hidden if unset/invalid.
VITE_TGE_DATE=

# ramp-system API (fiat<->crypto on/off-ramp, gift cards) — required for the
# on/off-ramp and gift-card screens. TODO: fill in the staging ramp-system URL.
VITE_RAMP_API=https://outlogic-ramp-staging-or11.azurewebsites.net

# Arkade Wrap (Typhoon) bridge
VITE_ARKADEWRAP_API=https://api-staging.arkadewrap.com

# Assets offered on staging: the full set, so the bridged assets can be tested.
# Every non-comingSoon wrapped asset here needs its VITE_ARKADE_* id below.
VITE_ENABLED_ASSETS=BTC,USDT,ETH,TRX,POL,CEXT

# Arkade wrapped asset IDs (staging)
VITE_ARKADE_ETH=395f6317bf02cb3ac05d43fed7081713f5cfc48c2ddbd32018c3ef2c4f48a0720000
VITE_ARKADE_USDT=ab809e9fe0ee2850949a21b53283488c67a5d7caaa1db39b01ad7a05dd9673ee0000
VITE_ARKADE_TRX=6c835614244b3aa69d83d783bd3519623911d8e8882a4d0f2ae78bbb756980240000
VITE_ARKADE_POL=aa7e5116da8cf57a1474a5605b0a2e9499296322b2287370742acad258c76fa20000
VITE_ARKADE_CEXT=8943b480eef5e3f2c7150cf16f61bb94b40f28c4eeab766203b517bfb35743c40000

# Bank withdrawal - company Ark wallet where user funds are sent
VITE_BANK_WITHDRAW_WALLET=tark1qra883hysahlkt0ujcwhv0x2n278849c3m7t3a08l7fdc40f4f2n69kk38gcv02fvc2hawpe6gu3xwuwvyhkaquzpuu0lhspw6vxtw0uler753

