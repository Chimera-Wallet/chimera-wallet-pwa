# Beta environment overrides
# (https://ashy-wave-06a45eb03-beta.westeurope.1.azurestaticapps.net)
#
# Beta is a pre-release build against PRODUCTION backends: real funds, real
# payouts. CI builds it with `--mode production`, so every value comes from
# .env.production; this file is sourced into the shell first and only holds
# the values that must differ (exported vars take precedence over Vite's .env
# files). Keep it to overrides — copying production values here lets beta
# drift from what ships. Values are shell-sourced: quote anything with spaces.

# Separate Plausible site, so beta traffic stays out of production analytics.
VITE_PLAUSIBLE_DOMAIN=ashy-wave-06a45eb03-beta.westeurope.1.azurestaticapps.net

# Dedicated beta Arkade Wrap backend and beta-issued wrapped assets.
VITE_ARKADEWRAP_API=https://api-beta.arkadewrap.com

# Wrapped assets, ahead of their production launch. Every enabled asset that
# isn't `comingSoon` needs its id, or requiredConfig.ts blocks the app at boot.
# These are MAINNET ids — never the signet ones from .env.staging. They live
# here rather than in .env.production because setting an id there changes
# production even with the asset disabled (it becomes a built-in verified
# asset). On launch, move the ids and the enabled set to .env.production and
# delete them from here.
VITE_ENABLED_ASSETS=BTC,USDT,ETH,TRX,POL,CEXT
VITE_ARKADE_USDT=16783b3e7ac0c7bbc2b418b967c47734b41dc5d0fdb09e0a5f37cf039e797c5d0000
VITE_ARKADE_ETH=01dcc51345e655fc41c6c736b10b7d614a383de16ff8015864bd0f23121bbeeb0000
VITE_ARKADE_TRX=1d7f6cdbce329170a8c9fc466f346d1a49a2a9ba2c5aa9eafdbd960540265b820000
VITE_ARKADE_POL=8ce10001b3cc042dbb1bbb17ee0bae264e09061345aeb1dd16fb3e83e2b2e9e60000
