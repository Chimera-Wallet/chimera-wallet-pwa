# Beta environment overrides
# (https://ashy-wave-06a45eb03-beta.westeurope.1.azurestaticapps.net)
#
# Beta is a pre-release build against PRODUCTION backends: real funds, real
# payouts. CI builds it with `--mode production`, so every value comes from
# .env.production; this file is sourced into the shell first and only holds
# the values that must differ (exported vars take precedence over Vite's .env
# files). Keep it to overrides — copying production values here lets beta
# drift from what ships. Values are shell-sourced: quote anything with spaces.

# Separate Plausible site, so beta traffic stays out of production analytics.
VITE_PLAUSIBLE_DOMAIN=ashy-wave-06a45eb03-beta.westeurope.1.azurestaticapps.net
VITE_ENABLED_ASSETS=BTC,USDT,ETH,TRX,POL,CEXT