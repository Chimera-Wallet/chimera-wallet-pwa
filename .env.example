# Example environment variables for Chimera Wallet PWA
# Copy this file to .env and modify as needed
# For production/staging environments, use .env.production or .env.staging

CI=false
GENERATE_SOURCEMAP=false

# Ark Network
# VITE_ARK_SERVER=https://arkade.computer
# VITE_BOLTZ_URL=https://api.ark.boltz.exchange

# Delegation (required): must be explicitly "true" or "false".
# VITE_DELEGATOR_URL is required only when VITE_DELEGATE_ENABLED=true.
# VITE_DELEGATE_ENABLED=false
# VITE_DELEGATOR_URL=https://delegate.arkade.money

# Chimera API
# VITE_CHIMERA_API=https://api.chimerawallet.com/v1

# TGE countdown (StakingBanner) — ISO date string. If unset or unparsable,
# the banner is shown without a countdown rather than failing.
# VITE_TGE_DATE=2026-09-08T12:00:00+00:00

# ramp-system API (gift cards, and bank transfers when
# VITE_BANK_TRANSFER_PROVIDER=ramp below) — required. No fallback:
# gift-card screens throw a clear error if this isn't set, rather than
# silently guessing an environment.
VITE_RAMP_API=

# Bank transfer (BankSend/BankReceive/BankOrderStatus) backend selector.
# 'chimera' (default) uses the legacy Chimera OTC API; 'ramp' uses
# ramp-system instead. See src/providers/bankTransfer.ts.
# VITE_BANK_TRANSFER_PROVIDER=chimera

# Arkade Wrap (Typhoon) bridge - EVM/TRON <-> Arkade wrapped assets (required)
VITE_ARKADEWRAP_API=https://api.arkadewrap.com

# Assets this build offers, comma-separated (REQUIRED, no default).
# Known symbols: BTC, USDT, ETH, TRX, POL, CEXT.
# Staging runs the full set; production lists only what has launched. A missing
# or empty value blocks the app at boot rather than guessing a set (see
# src/lib/requiredConfig.ts). An enabled asset that is still `comingSoon` in
# src/lib/assets.ts shows with a "Coming Soon" badge and cannot be sent.
VITE_ENABLED_ASSETS=

# Arkade wrapped asset IDs (differ between staging and production)
# VITE_ARKADE_ETH=
# VITE_ARKADE_USDT=
# VITE_ARKADE_TRX=
# VITE_ARKADE_POL=
# VITE_ARKADE_CEXT=

# Bank withdrawal - company Ark wallet where user funds are sent
# VITE_BANK_WITHDRAW_WALLET=

# Gift Cards
# VITE_GIFT_CARDS_BUY_URL=https://giftcards.chimerawallet.com/buy-card/
# VITE_GIFT_CARDS_REDEEM_URL=https://giftcards.chimerawallet.com/redeem-gift-card/

# KYC/IDFlow
# VITE_KYC_API_URL=https://api.idflow.ch
# VITE_KYC_WEBVIEW_URL=https://demo.idflow.ch/

# Plausible Analytics
# VITE_PLAUSIBLE_DOMAIN=app.chimerawallet.com

# ChatWoot
# VITE_CHATWOOT_WEBSITE_TOKEN=your-token
# VITE_CHATWOOT_BASE_URL=https://app.chatwoot.com

# Third-party integrations
# VITE_LENDASAT_IFRAME_URL=https://iframe.lendasat.com
# VITE_LENDASWAP_IFRAME_URL=https://iframe.lendaswap.com

# App URL overrides (optional)
# These override the default URLs configured in src/lib/appConfig.ts
# VITE_GIFT_CARDS_URL=
# VITE_CARD_RESERVATION_URL=
# VITE_STATEMENT_URL=
# VITE_REFERRAL_URL=

# Other optional settings
# VITE_SENTRY_DSN=
# VITE_MAX_PERCENTAGE=10
# VITE_PSA_MESSAGE=

# Wirex 
# VITE_WIREX_SDK_ENV=uat
# VITE_WIREX_COMPANY_ID=

# Wirex ENV variables needed on Azure (Function App settings, not Vite env —
# server-side only, see api/wirex/token.ts, proxy.ts, webhook.ts). Not read
# from this file; set them via `func settings add <name>` in
# api/local.settings.json for local dev, or the Function App's Configuration
# blade in Azure for staging/production.
#   WIREX_API_BASE            Wirex BaaS API base URL — also where the partner
#                              token is issued, POST {WIREX_API_BASE}/api/v1/token
#                              (docs.wirexapp.com/docs/retail-authentication)
#   WIREX_CHAIN_ID             Chain id forwarded as X-Chain-Id
#   WIREX_CLIENT_ID              Wirex partner client_credentials client id
#   WIREX_CLIENT_SECRET          Wirex partner client_credentials client secret
#   IDFLOW_API_URL                 IDFlow API base URL — used by api/wirex/proxy.ts to verify a
#                                   caller's X-Kyc-Access-Token before minting a Wirex user token
#                                   (same host as VITE_KYC_API_URL above, but read server-side) 
